# --- Python ---------------------------------------------------------------
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebooks ------------------------------------------------------------
.ipynb_checkpoints/

# --- Models ---------------------------------------------------------------
# Trained weights come from Google Colab and are too large for git.
# The tiny fallback graph IS versioned so the stack runs out-of-the-box.
*.onnx
!models/fallback/
!models/fallback/*.onnx
# The input check's image encoder (16.8 MB, MIT) is versioned so the Docker build needs no extra download.
!models/gate/
!models/gate/*.onnx
*.pt
*.pth

# --- Raw datasets & training artefacts ------------------------------------
# runs/ is versioned (curves, metrics, sample predictions); weights live on the
# model-v1 GitHub release instead (see scripts/download_model.py).
datasets/
data/raw/
data/datasets/
runs/**/weights/
*.part
Apple-Scab*/
*.zip

# --- Local scratch (input check study, downloaded photos) ---------------
/.work/

# --- Caches ---------------------------------------------------------------
.cache/
*.sqlite

# --- Environment / IDE / OS -----------------------------------------------
.env
.vscode/
.idea/
.DS_Store
Thumbs.db
